generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Settings {
  id             Int      @id @default(1)
  workTime       Int
  shortBreakTime Int
  longBreakTime  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Task {
  id            String   @id
  name          String
  duration      Int
  type          TaskType
  startDate     BigInt
  completeDate  BigInt?
  interruptDate BigInt?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startDate])
}

enum TaskType {
  workTime
  shortBreakTime
  longBreakTime
}
